APP_DOMAIN=servicos.apelmat.com.br
DJANGO_SECRET_KEY=TROQUE_AQUI_POR_UMA_CHAVE_GRANDE_E_ALEATORIA
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=servicos.apelmat.com.br
CSRF_TRUSTED_ORIGINS=https://servicos.apelmat.com.br
CORS_ALLOWED_ORIGINS=https://servicos.apelmat.com.br
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_COOKIES=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# Copie estes cinco dados exatamente do painel do banco MySQL da Locaweb.
MYSQL_HOST=HOST_MYSQL_FORNECIDO_PELA_LOCAWEB
MYSQL_PORT=3306
MYSQL_DATABASE=NOME_DO_BANCO
MYSQL_USER=USUARIO_DO_BANCO
MYSQL_PASSWORD=SENHA_DO_BANCO
GUNICORN_WORKERS=3
