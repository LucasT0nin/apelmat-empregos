# Copie este arquivo para .env.vps e troque todos os valores TROQUE_AQUI.
APP_DOMAIN=servicos.apelmat.com.br
DJANGO_SECRET_KEY=TROQUE_AQUI_POR_UMA_CHAVE_GRANDE_E_ALEATORIA
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=servicos.apelmat.com.br
CSRF_TRUSTED_ORIGINS=https://servicos.apelmat.com.br
CORS_ALLOWED_ORIGINS=https://servicos.apelmat.com.br

# O Caddy gera e renova o HTTPS automaticamente quando o DNS estiver apontado.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_COOKIES=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

MYSQL_DATABASE=apelmat
MYSQL_USER=apelmat
MYSQL_PASSWORD=TROQUE_AQUI_SENHA_DO_BANCO
MYSQL_ROOT_PASSWORD=TROQUE_AQUI_SENHA_ROOT_DO_BANCO
GUNICORN_WORKERS=3
